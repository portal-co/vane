# Minimal kernel config for the vane virt machine (PLAN_PI_IN_VM.md R8;
# PLAN_VIRTIO_WEVAL). Base: riscv64 defconfig. These fragments force the
# drivers the vane machine needs to be BUILTIN (=y), not modules, because the
# disk/9p/net boot flow has no initrd to load modules from.
#
# Use:  make ARCH=riscv64 defconfig && scripts/kconfig/merge_config.sh .config vane-kernel-minimal.config
#
# Finding (R8): the Debian *netboot* kernel ships VIRTIO_MMIO/VIRTIO_BLK as
# modules → root=/dev/vda fails with unknown-block(0,0). This config forces
# them builtin.

# ── virtio core + mmio transport (the vane machine's device bus) ─────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# ── virtio devices the vane machine exposes ──────────────────────────────────
CONFIG_VIRTIO_BLK=y          # disk (V2) — root=/dev/vda
CONFIG_VIRTIO_NET=y          # network (V4)
CONFIG_VIRTIO_CONSOLE=y      # virtio console
CONFIG_HW_RANDOM_VIRTIO=y    # virtio-rng (entropy for early boot)

# ── virtio-9p host filesystem share (V3) ─────────────────────────────────────
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── root filesystems on the virtio-blk disk ──────────────────────────────────
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y

# ── vane machine essentials (QEMU virt shape) ────────────────────────────────
# ns16550a console UART @ 0x1000_0000 (PLIC source 10)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
# PLIC + ACLINT (CLINT) interrupt/timer
CONFIG_RISCV_TIMER=y
# SiFive test finisher @ 0x10_0000 (SBI SRST poweroff/reboot)
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SYSFB_SIMPLEFB=n
# The machine has a DTB (vane generates it); no ACPI.
CONFIG_ACPI=n
